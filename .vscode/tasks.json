{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "WHOIS: Offline demo",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "examples/demo_healing.py"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "WHOIS: Run tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "pytest",
        "test/test_library_healing.py",
        "test/test_healing.py",
        "test/test_healing_config.py",
        "test/test_verify_ai_repair.py",
        "test/test_parser.py",
        "-q"
      ],
      "group": "test",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "WHOIS: Verify real AI repair",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "scripts/verify_ai_repair.py"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
